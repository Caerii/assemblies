      "repo_file": "docs/coinflipping.markdown",
      "papers": ["dabagia2024coinflipping"],
      "architecture": {
        "coin": "context area → state area (2 outcome assemblies) + i.i.d. activation noise",
        "probability": "softmax of context→outcome weights (NEMO params set scale)",
        "learning": "Hebbian rule inverts softmax so empirical frequency ≈ probability",
        "markov": "current-state area ↔ next-state area; inhibition schedule alternates areas"
      },
      "claims": [
        {
          "claim": "Fair coin via equal context→outcome weights + noise",
          "paper_id": "dabagia2024coinflipping",
