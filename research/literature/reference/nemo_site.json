      "repo_file": "docs/about.markdown",
      "role": "model_spec",
      "core_mechanisms": [
        "sparse random directed connectivity between areas",
        "k-winners-take-all per area per timestep",
        "Hebbian plasticity (i fires then j → strengthen w_ij)",
        "periodic area-wide inhibition (rhythmic abstraction)",
        "optional: inhibition gated by designated neuron sets (TM construction)"
      ],
