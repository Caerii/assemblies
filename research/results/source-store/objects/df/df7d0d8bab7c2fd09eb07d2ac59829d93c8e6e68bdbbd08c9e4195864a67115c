  lean-contracts:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4
      - uses: leanprover/lean-action@v1
        with:
          lake-package-directory: formal
          use-mathlib-cache: "false"
          # The action's own leanchecker step names the PACKAGE
          # (assembly-contracts) as a module and finds nothing; the library
          # is AssemblyIR, checked explicitly below.
          leanchecker: "false"
      - name: Re-check the built AssemblyIR environment with leanchecker
        working-directory: formal
        run: lake env leanchecker AssemblyIR
      - name: Validate the shared explicit-round corpus in Lean
        working-directory: formal
        run: >-
          lake exe check-wire-cases
          ../neural_assemblies/ir/v1/explicit-round.cases.json

  rust-ir:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4
      - name: Validate the shared protocol corpus
        working-directory: crates
        run: cargo test --locked -p assembly-ir
