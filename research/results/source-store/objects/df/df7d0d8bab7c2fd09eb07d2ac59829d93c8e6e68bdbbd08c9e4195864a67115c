name: Research contracts

on:
  pull_request:
  push:
    branches: [dev, master]

permissions:
  contents: read

jobs:
  cpu-contracts:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      # Full history: the evidence graph verifies each comparison receipt
      # against `git show <commit>:research/compare_migration.py` at the
      # commit that wrote it, which a depth-1 clone does not contain.
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - uses: astral-sh/setup-uv@v4
      # The development environment installs the `gpu` group (CUDA torch, and
      # CuPy on Linux) by default. This runner has no GPU, so it opts out and
      # installs the CPU build of the SAME locked torch instead: research
      # contracts build CPU tensors (state codes, chain tables), so the torch
      # level runs here; CUDA and the fused kernels do not, and their tests
      # skip with the reason. That also keeps the job off the 3 GB CUDA stack.
      - run: uv sync --frozen --no-group gpu
      # The strict setting below makes a failed install FAIL the torch tests
      # instead of skipping them (neural_assemblies/tests/_devices.py).
      - name: Install the CPU build of the locked torch
        run: uv pip install "torch==2.12.1" --index-url https://download.pytorch.org/whl/cpu
      - name: Reject unsafe research invocations and dead verification
        env:
          ASSEMBLIES_REQUIRE_DEVICE: torch
        run: >-
          uv run --no-sync --with pyright pytest -q
          neural_assemblies/tests/test_device_gate.py
          neural_assemblies/tests/test_research_contracts.py
