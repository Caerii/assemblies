"""Refraction in the VENDORED reference FSM, measured as-is, through the shared runner.

[[ARC-CONJUNCT-EXPOSURE]] [[REFRACTION-PROPORTIONAL]]

This measures `neural_assemblies/reference/nemo_numpy` only -- no `Brain` is
involved -- because before porting Theorem 4's three-area FSM we needed to
know which of the reference's mechanisms are load-bearing and which are
decoration. The three-seed answer is in the legacy log
(`research/results/logs/seq_arc_refraction_reference.log`); the twenty-seed
run with retained per-seed arms is registered in
`research/notes/sequence/PREREG_arc_refraction_reference.md`.

QUESTIONS AND DECISION RULES (stated before the numbers were read):

  Q1 GOLDEN. Does the reference decide correctly? If it does not, there is
     no target and every downstream parity claim is vacuous.

  Q2 WHICH WAY DOES THE ARC COLLAPSE? Measure BOTH degeneracies:
        across-STATE  overlap at fixed symbol  -> high means A_sigma (state-blind)
        across-SYMBOL overlap at fixed state   -> high means A_q     (symbol-blind)
     Measuring only one direction cannot distinguish a conjunction from a
     collapse onto the OTHER conjunct, so both are retained.

  Q3 IS REFRACTION LOAD-BEARING? Ablate it. If the task still passes without
     it, refraction is tiling cosmetics.

  Q4 IS A CONSTANT RULE EQUIVALENT? The reference accumulates
        bias[winner] += raw_drive[winner] * plasticity        (drive-proportional)
     while this repository's engines once accumulated
        bias[winner] += refracted_strength                    (constant)
     Swap in the constant rule and sweep it. A constant is an acceptable
     substitute ONLY if some fixed value works AND keeps working when the
     drive scale changes; Hebbian growth multiplies drive by (1+beta) per
     presentation, so a constant increment falls behind by construction
     unless the sweep says otherwise. Test by varying presentation count: if
     the winning constant MOVES, the parameter is unnormalized.

Run:  python -m research.runner arc-refraction-reference --tag UNIQUE
      (smoke: --smoke --seeds 42 43 44; VOID)
"""
from __future__ import annotations

from dataclasses import asdict
from pathlib import Path
import types

import numpy as np

from neural_assemblies import describe_nemo_numpy_reference
from neural_assemblies.diagnostics import ensemble_from_values
from neural_assemblies.reference.nemo_numpy.areas import FFArea, RefractedArea
from neural_assemblies.reference.nemo_numpy.fsm_network import (
    FSMNetwork, build_mod3_symbols_states, mod3_transition_list,
)
from research.runner import (
    experiment_parser, run_experiment, validate_registered_seeds,
    validate_seed_identities,
)

PROTOCOL = "sequence.arc-refraction-reference"
VERSION = "2"          # version 1 is the three-seed legacy log, no run record
REGISTRATION = "research/notes/sequence/PREREG_arc_refraction_reference.md"
REGISTERED_SEEDS = tuple(range(42, 62))

CAP = 70
N_SYMBOL, N_STATE, N_ARC = 1000, 500, 5000
DENSITY, PLASTICITY = 0.2, 0.1
LABELS = {0: "0", 1: "1", 2: "2", 3: "accept", 4: "reject"}
POSITIVE = (3, 0, 4, 7, 1, 10)      # digits sum to 15, 15 % 3 == 0 -> accept
NEGATIVE = (6, 7, 3, 10)            # digits sum to 16, 16 % 3 == 1 -> reject
CHANCE_OVERLAP = CAP / N_ARC

CONSTANT_STRENGTHS = (1.0, 3.0, 10.0, 30.0, 100.0)
PRESENTATION_COUNTS = (5, 15, 30)


def registered_arms():
    """Every (rule, strength, presentations) the registration names."""
    arms = [{"rule": "proportional", "strength": 0.0, "presentations": p}
            for p in PRESENTATION_COUNTS]
    arms.append({"rule": "off", "strength": 0.0, "presentations": 15})
    arms += [{"rule": "constant", "strength": s, "presentations": p}
             for s in CONSTANT_STRENGTHS for p in PRESENTATION_COUNTS]
    return arms


def smoke_arms():
    return [{"rule": "proportional", "strength": 0.0, "presentations": 2},
            {"rule": "off", "strength": 0.0, "presentations": 2},
            {"rule": "constant", "strength": 10.0, "presentations": 2}]


def arm_key(arm) -> str:
    if arm["rule"] == "constant":
        return f"constant-s{arm['strength']:g}-p{arm['presentations']}"
    return f"{arm['rule']}-p{arm['presentations']}"


class ConstantRefractedArea(RefractedArea):
    """The constant rule: a fixed increment per firing, blind to drive."""

    def __init__(self, *a, const_strength: float = 0.1, **kw):
        self.const_strength = const_strength
        super().__init__(*a, **kw)

    def update(self, new_activations):
        self.bias[new_activations] += self.const_strength
        FFArea.update(self, new_activations)


def train(seed, *, rule="proportional", strength=0.0, presentations=15):
    """Train the reference FSM under one refraction rule.

    `rule` is one of "proportional" (the reference), "constant", or "off"
    (no bias accumulation at all -- the ablation).
    """
    rng = np.random.default_rng(seed)
    fsm = FSMNetwork(N_SYMBOL, N_STATE, N_ARC, CAP, DENSITY, PLASTICITY, rng)
    if rule == "constant":
        fsm.arc_area = ConstantRefractedArea(
            [N_SYMBOL, N_STATE], N_ARC, CAP, DENSITY, PLASTICITY, rng,
            const_strength=strength,
        )
    elif rule == "off":
        # FFArea.update never touches `bias`, which RefractedArea then subtracts
        # as a vector of zeros -- refraction removed without touching anything else.
        fsm.arc_area.update = types.MethodType(FFArea.update, fsm.arc_area)
    elif rule != "proportional":
        raise ValueError(f"unknown refraction rule {rule!r}")

    symbols, states = build_mod3_symbols_states(CAP, rng)
    for _ in range(presentations):
        for from_state, symbol, to_state in mod3_transition_list():
            fsm.train(symbols[symbol], states[from_state], states[to_state])

    # Manipulation check: an arm that was supposed to change the bias must have.
    peak = float(fsm.arc_area.bias.max())
    if rule == "off":
        if peak != 0.0:
            raise RuntimeError("ablation arm accumulated bias anyway")
    elif presentations > 0 and (rule == "proportional" or strength > 0.0):
        if peak <= 0.0:
            raise RuntimeError("refraction arm accumulated no bias")
    return fsm, symbols, states


def arc_assembly(fsm, symbol, state):
    """Arc winners for one (state, symbol), with no plasticity and no bias update."""
    fsm.inhibit()
    fsm.arc_area.forward([symbol, state], update=False)
    return fsm.arc_area.read()


def collapse_overlaps(fsm, symbols, states):
    """(across-state, across-symbol) mean pairwise arc overlap."""
    across_state = []
    for digit in range(10):
        a = [arc_assembly(fsm, symbols[digit], states[q]) for q in range(3)]
        across_state += [len(np.intersect1d(a[i], a[j])) / CAP
                         for i in range(3) for j in range(i + 1, 3)]
    across_symbol = []
    for q in range(3):
        a = [arc_assembly(fsm, symbols[d], states[q]) for d in range(10)]
        across_symbol += [len(np.intersect1d(a[i], a[j])) / CAP
                          for i in range(10) for j in range(i + 1, 10)]
    return float(np.mean(across_state)), float(np.mean(across_symbol))


def decide(fsm, symbols, states, sequence):
    """Run a digit string from state 0 and label the final state assembly."""
    fsm.inhibit()
    fsm.state_area.fire(states[0], update=False)
    for symbol in sequence:
        fsm.forward(symbols[symbol], update=False)
    read = fsm.read()
    best = max(range(len(states)),
               key=lambda i: len(np.intersect1d(read, states[i])) / max(len(read), 1))
    return LABELS[best]


def _ensemble(values, label, seeds):
    e = ensemble_from_values(list(values), label, keys=list(seeds))
    return {**asdict(e), "low": e.low, "high": e.high}


def run_arm(arm, seeds):
    rows = []
    for seed in seeds:
        fsm, symbols, states = train(seed, rule=arm["rule"], strength=arm["strength"],
                                     presentations=arm["presentations"])
        a, b = collapse_overlaps(fsm, symbols, states)
        pos = decide(fsm, symbols, states, POSITIVE)
        neg = decide(fsm, symbols, states, NEGATIVE)
        rows.append({"seed": seed, "across_state": a, "across_symbol": b,
                     "positive_label": pos, "negative_label": neg,
                     "decided": int(pos == "accept" and neg == "reject")})
    key = arm_key(arm)
    decided = sum(r["decided"] for r in rows)
    print(f"  {key:<20s} across-state {np.mean([r['across_state'] for r in rows]):.3f}  "
          f"across-symbol {np.mean([r['across_symbol'] for r in rows]):.3f}  "
          f"decided {decided}/{len(rows)}", flush=True)
    return {**arm, "rows": rows, "decided": decided, "n": len(rows),
            "ensembles": {
                "across_state": _ensemble([r["across_state"] for r in rows], f"{key} across-state", seeds),
                "across_symbol": _ensemble([r["across_symbol"] for r in rows], f"{key} across-symbol", seeds),
            }}


def _bars(arms, n):
    """The registration's bars, evaluated on the retained arms (study mode only)."""
    def get(key):
        return arms.get(key)
    out = {}
    prop15, off15, prop30 = get("proportional-p15"), get("off-p15"), get("proportional-p30")
    if prop15 is not None:
        out["AR-1 proportional at 15: decided >= 18/20 and both overlaps <= 0.05"] = bool(
            prop15["decided"] >= 18 * n // 20
            and prop15["ensembles"]["across_state"]["mean"] <= 0.05
            and prop15["ensembles"]["across_symbol"]["mean"] <= 0.05)
    if off15 is not None:
        out["AR-2 off at 15: across-symbol >= 0.5 on every seed, decided <= 2/20, across-state mean <= 0.2"] = bool(
            all(r["across_symbol"] >= 0.5 for r in off15["rows"])
            and off15["decided"] <= 2 * n // 20
            and off15["ensembles"]["across_state"]["mean"] <= 0.2)
    constants15 = {k: v for k, v in arms.items()
                   if v["rule"] == "constant" and v["presentations"] == 15}
    if constants15:
        best_key = max(constants15, key=lambda k: constants15[k]["decided"])
        best = constants15[best_key]
        out["AR-3 some constant decides >= 18/20 at 15"] = bool(best["decided"] >= 18 * n // 20)
        best30 = get(f"constant-s{best['strength']:g}-p30")
        if best30 is not None and prop30 is not None:
            out[f"AR-4 s* = {best['strength']:g}: decided <= 2/20 at 30 while proportional >= 18/20 at 30"] = bool(
                best30["decided"] <= 2 * n // 20 and prop30["decided"] >= 18 * n // 20)
            out["AR-4 s*"] = best["strength"]
    return out


def experiment(record):
    if record.get("mode", "study") == "study":
        validate_seed_identities(record["seeds"], REGISTERED_SEEDS)
    seeds = record["seeds"]
    parameters = record["parameters"]
    if (parameters["cap"], parameters["n_symbol"], parameters["n_state"], parameters["n_arc"],
            parameters["density"], parameters["plasticity"]) != (
            CAP, N_SYMBOL, N_STATE, N_ARC, DENSITY, PLASTICITY):
        raise ValueError("this protocol version does not implement changed sizes")
    print(f"chance overlap k/n = {CHANCE_OVERLAP:.3f}; seeds {seeds}")
    arms = {}
    for arm in parameters["arms"]:
        arms[arm_key(arm)] = run_arm(arm, seeds)
    smoke = record["mode"] == "smoke"
    bars = {} if smoke else _bars(arms, len(seeds))
    judged = [v for v in bars.values() if isinstance(v, bool)]
    verdict = "VOID" if smoke else ("PASS" if judged and all(judged) else "FAIL")
    for name, ok in bars.items():
        if isinstance(ok, bool):
            print(f"  {'PASS' if ok else 'FAIL'}  {name}")
    return {"verdict": verdict, "bars": bars, "arms": arms,
            "chance_overlap": CHANCE_OVERLAP,
            "scope": "vendored reference arc: refraction ablation and constant-versus-proportional rule"}


def main(argv=None):
    parser = experiment_parser(
        "Refraction in the vendored reference arc (ablation and rule comparison)",
        engines=("reference_nemo_numpy",), default_seeds=REGISTERED_SEEDS,
    )
    args = parser.parse_args(argv)
    validate_registered_seeds(parser, args, REGISTERED_SEEDS)
    parameters = {"cap": CAP, "n_symbol": N_SYMBOL, "n_state": N_STATE, "n_arc": N_ARC,
                  "density": DENSITY, "plasticity": PLASTICITY,
                  "positive": list(POSITIVE), "negative": list(NEGATIVE),
                  "arms": smoke_arms() if args.smoke else registered_arms()}
    path = run_experiment(
        script=Path(__file__), protocol=PROTOCOL, protocol_version=VERSION,
        registration=REGISTRATION, engine=args.engine, seeds=args.seeds,
        tag=args.tag, smoke=args.smoke, parameters=parameters,
        model_semantics=describe_nemo_numpy_reference(), measure=experiment,
        observation_policy="frozen",  # the reference reads with update=False; it has no recruitment
    )
    print(path)


if __name__ == "__main__":
    main()
