                        explicit_dense_act = contrib.astype(xp.float32, copy=True)
                    else:
                        explicit_dense_act += contrib
                    continue
                neuron_ids = xp.asarray(
                    tgt.compact_to_neuron_id, dtype=xp.int64,
                )
